# Single-user self-hosted workspace. In local development this defaults to
# ./data; Docker always uses its mounted /app/data volume instead.
FINALE_DATA_DIR=./data
# 资料目录总容量上限（字节）。默认 8GB。
FINALE_MAX_UPLOAD_BYTES=8589934592
# Compose 备份间隔秒数，默认 86400（每天）。
FINALE_BACKUP_INTERVAL_SECONDS=86400

# Either configure a private server-owned key, or leave this blank and enter a
# session-only key from the in-app AI Settings screen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional OpenAI-compatible API root. Use a root such as
# https://api.openai.com/v1, never a concrete /responses or /files endpoint.
OPENAI_BASE_URL=

# `next dev` permits a server key. Docker/production deliberately does not
# unless this is explicitly enabled for a trusted private single-user host.
AI_ALLOW_UNAUTHENTICATED_SERVER_KEY=false

# Browser-selected compatible endpoints are allowed locally. Leave false for
# production unless the deployment has authentication, rate limits and SSRF
# controls in front of this app. A browser-selected endpoint always requires
# its own session key; environment keys are only paired with OPENAI_BASE_URL.
AI_ALLOW_CUSTOM_BASE_URL=false

# Reserved for the future multi-user PostgreSQL/object-storage/email adapters.
# They are not read by the current local self-hosted runtime.
DATABASE_URL=
STORAGE_BUCKET=
EMAIL_FROM=

# Cross-origin protection. Set the browser origin(s) when running behind a reverse proxy.
FINALE_ALLOWED_ORIGINS=

# Rate limiting reads x-forwarded-for/x-real-ip only when this is true; the
# reverse proxy must strip inbound forwarding headers before setting its own.
# Without it, all direct clients share one in-process limit bucket so that
# spoofed forwarding headers cannot bypass the limiter.
FINALE_TRUST_PROXY=false

# Email verification for school-scoped community features. The provider must
# accept POST JSON {to, subject, text, purpose} and return 2xx. No OTP is
# generated or reported as sent until this provider and secret are configured.
EMAIL_PROVIDER_URL=
# 生产环境必须配置；未配置时邮箱验证会返回 503。
EMAIL_PROVIDER_TOKEN=
AUTH_OTP_SECRET=
# Comma-separated exact domain mappings, for example: example.edu=示例大学
SCHOOL_EMAIL_DOMAINS=

# Bearer token used only by the operator moderation endpoint. Keep it outside
# the repository and rotate it if exposed. Production requires at least 32 characters.
COMMUNITY_ADMIN_TOKEN=

# The in-process limiter is enabled by default. Disable only when a trusted
# reverse proxy supplies an equivalent distributed limiter.
FINALE_RATE_LIMIT_DISABLED=false
